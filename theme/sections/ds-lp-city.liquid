    { "type": "text", "id": "feature_heading", "label": "Heading", "default": "Delivery and installation, coordinated end to end." },
    { "type": "textarea", "id": "feature_sub", "label": "Sub-copy" },
    { "type": "header", "content": "Recent local projects (REAL only)" },
    { "type": "text", "id": "proof_eyebrow", "label": "Eyebrow", "default": "Recent local projects" },
