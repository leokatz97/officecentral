<style>
/* ============================================================
   BBI Design Tokens — DS v2 (shared with ds-lp-* / ds-review-base)
   ============================================================ */
:root {
  --bodyFont: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --headingFont: "Inter Tight", "Inter", system-ui, sans-serif;
  --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px;
  --space-6: 24px; --space-8: 32px; --space-12: 48px; --space-16: 64px;
  --inputRadius: 4px; --buttonRadius: 4px; --cardRadius: 8px;
  --shadow-sm: 0 1px 2px rgba(11,11,12,.04), 0 2px 8px rgba(11,11,12,.05);
  --saleBadgeBackground: #D4252A;
  --saleBadgeBackground-rgb: 212,37,42;
  --fs-h0: 44px; --lh-h0: 1.05; --ls-h0: -0.02em;
  --fs-h1: 32px; --lh-h1: 1.1; --ls-h1: -0.015em;
  --fs-h2: 24px; --lh-h2: 1.15; --ls-h2: -0.01em;
  --fs-h3: 18px; --lh-h3: 1.25;
  --fs-body: 16px; --lh-body: 1.55;
  --fs-small: 13px;
  --fs-button: 15px; --lh-button: 1; --ls-button: 0.01em;
}
@media (min-width: 768px) {
  :root {
    --fs-h0: 72px; --lh-h0: 1.0;
    --fs-h1: 48px; --lh-h1: 1.05;
    --fs-h2: 32px; --lh-h2: 1.1;
    --fs-h3: 22px; --lh-h3: 1.2;
    --fs-small: 14px;
  }
}
.lp-ds.scheme-default {
  --background: #FFFFFF; --background-rgb: 255,255,255;
  --alternateBackground: #FAFAFA; --alternateBackground-rgb: 250,250,250;
  --cardBackground: #FFFFFF;
  --textColor: #0B0B0C; --textColor-rgb: 11,11,12;
  --linkColor: #0B0B0C; --headingColor: #0B0B0C; --headingColor-rgb: 11,11,12;
  --buttonBackground: #D4252A; --buttonColor: #FFFFFF; --buttonBorder: #D4252A;
  --buttonBackgroundHover: #0B0B0C; --buttonColorHover: #FFFFFF; --buttonBorderHover: #0B0B0C;
  --alternateButtonBackground: #FFFFFF; --alternateButtonColor: #0B0B0C; --alternateButtonBorder: #0B0B0C;
  --alternateButtonBackgroundHover: #0B0B0C; --alternateButtonColorHover: #FFFFFF; --alternateButtonBorderHover: #0B0B0C;
  --borderColor: #E5E5E7; --borderColor-rgb: 229,229,231;
  --shadowColor: #0B0B0C; --shadowColor-rgb: 11,11,12;
  --font-mono: "JetBrains Mono", ui-monospace, monospace;
}
.lp-ds .scheme-inverse {
  --background: #0B0B0C; --background-rgb: 11,11,12;
  --alternateBackground: #161618;
  --textColor: #FFFFFF; --textColor-rgb: 255,255,255;
  --linkColor: #FFFFFF; --headingColor: #FFFFFF; --headingColor-rgb: 255,255,255;
  --buttonBackground: #FFFFFF; --buttonColor: #0B0B0C; --buttonBorder: #FFFFFF;
  --buttonBackgroundHover: #D4252A; --buttonColorHover: #FFFFFF; --buttonBorderHover: #D4252A;
  --alternateButtonBackground: transparent; --alternateButtonColor: #FFFFFF; --alternateButtonBorder: #FFFFFF;
  --alternateButtonBackgroundHover: #FFFFFF; --alternateButtonColorHover: #0B0B0C; --alternateButtonBorderHover: #FFFFFF;
  --borderColor: #1F1F21;
}

/* ============================================================
   Base + Shared Components
   ============================================================ */
.lp-ds *, .lp-ds *::before, .lp-ds *::after { box-sizing: border-box; }
.lp-ds { font-family: var(--bodyFont); font-size: var(--fs-body); line-height: var(--lh-body); color: var(--textColor); background: var(--background); -webkit-font-smoothing: antialiased; }
.lp-ds img { display: block; max-width: 100%; height: auto; }
.lp-ds a { color: var(--linkColor); }
.lp-ds .bbi-mono { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }
.lp-ds .bbi-icon--leaf { display: inline-block; width: 14px; height: 14px; vertical-align: -2px; color: #D4252A; flex-shrink: 0; }
.lp-ds .bbi-btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: var(--space-2); padding: 12px 20px; min-height: 44px;
  font-family: var(--bodyFont); font-size: var(--fs-button); line-height: var(--lh-button);
  letter-spacing: var(--ls-button); font-weight: 600; border-radius: var(--buttonRadius);
  border: 1px solid transparent; cursor: pointer; text-decoration: none;
  transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease;
  white-space: nowrap;
}
.lp-ds .bbi-btn:focus-visible { outline: 2px solid var(--textColor); outline-offset: 2px; }
.lp-ds .bbi-btn--lg { min-height: 52px; padding: 16px 24px; font-size: 16px; }
.lp-ds .bbi-btn--full { width: 100%; }
.lp-ds .bbi-btn--primary { background: var(--buttonBackground); color: var(--buttonColor); border-color: var(--buttonBorder); }
.lp-ds .bbi-btn--primary:hover { background: var(--buttonBackgroundHover); color: var(--buttonColorHover); border-color: var(--buttonBorderHover); }
.lp-ds .bbi-btn--secondary { background: var(--alternateButtonBackground); color: var(--alternateButtonColor); border-color: var(--alternateButtonBorder); }
.lp-ds .bbi-btn--secondary:hover { background: var(--alternateButtonBackgroundHover); color: var(--alternateButtonColorHover); border-color: var(--alternateButtonBorderHover); }
.lp-ds .arrow { display: inline-block; transition: transform 120ms ease; }
.lp-ds .bbi-btn:hover .arrow { transform: translateX(3px); }
.lp-ds .bbi-badge--oecm {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 10px; background: #F0F4FF; color: #0B0B0C;
  border: 1px solid #CBD5F0; border-radius: 4px;
  font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
}
.lp-ds .bbi-badge--oecm .dot { width: 6px; height: 6px; border-radius: 50%; background: #2563EB; flex-shrink: 0; }

/* ============================================================
   Hero
   ============================================================ */
.lp-hero { background: var(--alternateBackground); padding: var(--space-16) 0; }
.lp-hero__inner { max-width: 1200px; margin: 0 auto; padding: 0 var(--space-6); display: grid; grid-template-columns: 1fr; gap: var(--space-12); align-items: center; }
@media (min-width: 768px) { .lp-hero__inner { grid-template-columns: 1fr 1fr; gap: var(--space-16); } }
.lp-hero__eyebrow { color: var(--textColor); opacity: 0.55; margin: 0 0 var(--space-4); }
.lp-hero__eyebrow-label { opacity: 1; }
.lp-hero__text h1 { font-family: var(--headingFont); font-size: var(--fs-h0); line-height: var(--lh-h0); letter-spacing: var(--ls-h0); font-weight: 600; color: var(--headingColor); margin: 0 0 var(--space-6); }
.lp-hero__standfirst { font-size: 18px; line-height: 1.6; color: var(--textColor); opacity: 0.8; margin: 0 0 var(--space-8); max-width: 540px; }
.lp-hero__cta-row { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; }
.lp-hero__media { border-radius: var(--cardRadius); overflow: hidden; }
.lp-hero__media img { width: 100%; height: 400px; object-fit: cover; border-radius: var(--cardRadius); }
.lp-hero__badge { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 var(--space-6); font-size: 13px; font-weight: 600; color: var(--textColor); }
.lp-hero__badge-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--saleBadgeBackground); flex-shrink: 0; }

/* ============================================================
   Intro (answer-first) + E-E-A-T byline
   ============================================================ */
.lp-intro { background: var(--background); padding: var(--space-16) 0; }
.lp-intro__inner { max-width: 1280px; margin: 0 auto; padding: 0 var(--space-6); }
.lp-intro__eyebrow { color: var(--textColor); opacity: 0.5; margin: 0 0 var(--space-4); }
.lp-intro__inner h2 { font-family: var(--headingFont); font-size: var(--fs-h1); line-height: var(--lh-h1); font-weight: 600; color: var(--headingColor); margin: 0 0 var(--space-6); max-width: 760px; text-wrap: balance; }
.lp-intro__byline { display: flex; align-items: flex-start; gap: 8px; font-size: 13px; line-height: 1.5; color: rgba(var(--textColor-rgb), 0.6); margin: 0 0 var(--space-8); max-width: 760px; }
.lp-intro__byline .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--saleBadgeBackground); flex-shrink: 0; margin-top: 5px; }
.lp-intro__byline b { color: rgba(var(--textColor-rgb), 0.85); font-weight: 600; }
.lp-intro__body { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
@media (min-width: 768px) { .lp-intro__body { grid-template-columns: 1fr 1fr; } }
.lp-intro__body p { margin: 0; line-height: 1.7; }
.lp-intro__body h3 { font-family: var(--headingFont); font-size: var(--fs-h3); line-height: var(--lh-h3); font-weight: 600; color: var(--headingColor); margin: 0 0 var(--space-2); }

/* ============================================================
   Diff / how-we-serve / local-proof grids (shared .lp-diff)
   ============================================================ */
.lp-diff { background: var(--alternateBackground); padding: var(--space-16) 0; border-top: 1px solid var(--borderColor); border-bottom: 1px solid var(--borderColor); }
.lp-diff__inner { max-width: 1200px; margin: 0 auto; padding: 0 var(--space-6); }
.lp-diff__head { margin-bottom: var(--space-12); }
.lp-diff__eyebrow { color: var(--textColor); opacity: 0.5; margin: 0 0 var(--space-4); }
.lp-diff__head h2 { font-family: var(--headingFont); font-size: var(--fs-h1); line-height: var(--lh-h1); font-weight: 600; color: var(--headingColor); margin: 0; max-width: 640px; }
.lp-diff__head p.lp-diff__sub { font-size: 16px; line-height: 1.6; color: var(--textColor); opacity: 0.7; margin: var(--space-4) 0 0; max-width: 680px; }
.lp-diff__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
@media (min-width: 640px) { .lp-diff__grid { grid-template-columns: 1fr 1fr; } }
@media (min-width: 1024px) { .lp-diff__grid { grid-template-columns: repeat(4, 1fr); } }
.lp-diff__grid--3 { grid-template-columns: 1fr; }
@media (min-width: 640px) { .lp-diff__grid--3 { grid-template-columns: 1fr 1fr; } }
@media (min-width: 1024px) { .lp-diff__grid--3 { grid-template-columns: repeat(3, 1fr); } }
.lp-diff-card { background: var(--cardBackground); border: 1px solid var(--borderColor); border-radius: var(--cardRadius); padding: var(--space-8); display: flex; flex-direction: column; gap: var(--space-4); }
.lp-diff-card__num { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.08em; color: var(--textColor); opacity: 0.35; }
.lp-diff-card__icon { width: 36px; height: 36px; color: var(--textColor); }
.lp-diff-card__icon svg { width: 100%; height: 100%; }
.lp-diff-card__label { font-family: var(--headingFont); font-size: var(--fs-h3); line-height: var(--lh-h3); font-weight: 600; color: var(--headingColor); margin: 0; }
.lp-diff-card__sentence { font-size: 14px; line-height: 1.6; color: var(--textColor); opacity: 0.75; margin: 0; }
.lp-diff-card__meta { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--textColor); opacity: 0.55; margin: 0; }

/* ============================================================
   Cross-link tiles (Session A standardization)
   ============================================================ */
.lp-ds .lp-crosslinks{padding:var(--space-16) 0;background:var(--background);border-top:1px solid rgba(var(--borderColor-rgb),0.6);}
.lp-ds .lp-crosslinks__inner{max-width:1280px;margin:0 auto;padding:0 var(--space-6);}
.lp-ds .lp-crosslinks__head{margin-bottom:var(--space-8);}
.lp-ds .lp-crosslinks__eyebrow{display:inline-flex;align-items:center;gap:var(--space-2);color:rgba(var(--textColor-rgb),0.6);margin-bottom:var(--space-3);}
.lp-ds .lp-crosslinks__eyebrow::before{content:"";display:inline-block;width:18px;height:1px;background:var(--saleBadgeBackground);}
.lp-ds .lp-crosslinks h2{font-family:var(--headingFont);font-size:var(--fs-h2);line-height:var(--lh-h2);font-weight:600;color:var(--headingColor);margin:0;text-wrap:balance;}
.lp-ds .lp-crosslinks__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-4);}
.lp-ds .lp-crosslinks__tile{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:var(--space-4);padding:var(--space-6);background:var(--background);border:1px solid rgba(var(--borderColor-rgb),0.8);border-radius:var(--cardRadius);text-decoration:none;color:var(--textColor);transition:background-color 160ms ease,border-color 160ms ease;}
.lp-ds .lp-crosslinks__tile:hover{background:var(--alternateBackground);}
.lp-ds .lp-crosslinks__tile-icon{width:28px;height:28px;color:rgba(var(--textColor-rgb),0.55);}
.lp-ds .lp-crosslinks__tile-label{display:flex;flex-direction:column;gap:2px;}
.lp-ds .lp-crosslinks__tile-name{font-family:var(--headingFont);font-size:18px;font-weight:600;color:var(--headingColor);}
.lp-ds .lp-crosslinks__tile-meta{font-size:13px;color:rgba(var(--textColor-rgb),0.6);font-family:"JetBrains Mono",ui-monospace,monospace;letter-spacing:0.04em;}
.lp-ds .lp-crosslinks__tile-arrow{width:18px;height:18px;color:rgba(var(--textColor-rgb),0.55);transition:transform 160ms ease;}
.lp-ds .lp-crosslinks__tile:hover .lp-crosslinks__tile-arrow{transform:translateX(4px);color:var(--textColor);}

/* ============================================================
   Entity / OECM note
   ============================================================ */
.lp-ds .lp-entity-note{padding:var(--space-12) 0;background:var(--alternateBackground);border-top:1px solid rgba(var(--borderColor-rgb),0.6);}
.lp-ds .lp-entity-note__inner{max-width:1280px;margin:0 auto;padding:0 var(--space-6);display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-6);}
.lp-ds .lp-entity-note__badge{flex-shrink:0;}
.lp-ds .lp-entity-note p{font-size:13px;line-height:1.55;color:rgba(var(--textColor-rgb),0.65);margin:0;text-wrap:pretty;max-width:88ch;}
.lp-ds .lp-entity-note b{color:rgba(var(--textColor-rgb),0.85);font-weight:600;}

/* ============================================================
   FAQ
   ============================================================ */
.lp-faq { background: var(--background); padding: var(--space-16) 0; }
.lp-faq__inner { max-width: 1200px; margin: 0 auto; padding: 0 var(--space-6); }
.lp-faq__head { margin-bottom: var(--space-12); }
.lp-faq__eyebrow { color: var(--textColor); opacity: 0.5; margin: 0 0 var(--space-4); }
.lp-faq__head h2 { font-family: var(--headingFont); font-size: var(--fs-h1); line-height: var(--lh-h1); font-weight: 600; color: var(--headingColor); margin: 0; max-width: 700px; }
.lp-faq__item { border-bottom: 1px solid var(--borderColor); }
.lp-faq__trigger { width: 100%; display: flex; align-items: center; gap: var(--space-4); padding: var(--space-6) 0; background: none; border: none; cursor: pointer; text-align: left; font-family: var(--bodyFont); font-size: 16px; font-weight: 600; color: var(--headingColor); }
.lp-faq__trigger:focus-visible { outline: 2px solid var(--textColor); outline-offset: 2px; border-radius: 2px; }
.lp-faq__trigger-num { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.06em; color: var(--textColor); opacity: 0.35; flex-shrink: 0; width: 22px; }
.lp-faq__trigger span:nth-child(2) { flex: 1; }
.lp-faq__chevron { flex-shrink: 0; transition: transform 200ms ease; color: var(--textColor); opacity: 0.5; }
.lp-faq__item--open .lp-faq__chevron { transform: rotate(180deg); }
.lp-faq__answer { display: none; padding: 0 0 var(--space-6) calc(22px + var(--space-4)); }
.lp-faq__item--open .lp-faq__answer { display: block; }
.lp-faq__answer p { margin: 0 0 var(--space-4); line-height: 1.7; }
.lp-faq__answer p:last-child { margin-bottom: 0; }

/* ============================================================
   CTA Closer
   ============================================================ */
.bbi-cta-section { padding: var(--space-16) 0; background: var(--background); }
.bbi-cta-section__inner { max-width: 1200px; margin: 0 auto; padding: 0 var(--space-6); display: grid; grid-template-columns: 1fr; gap: var(--space-12); align-items: center; }
@media (min-width: 768px) { .bbi-cta-section__inner { grid-template-columns: 1fr auto; } }
.bbi-cta-section__eyebrow { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--textColor); opacity: 0.5; margin: 0 0 var(--space-4); }
.bbi-cta-section__heading { font-family: var(--headingFont); font-size: var(--fs-h1); line-height: var(--lh-h1); font-weight: 600; color: var(--headingColor); margin: 0 0 var(--space-4); }
.bbi-cta-section__sub { font-size: 16px; line-height: 1.65; color: var(--textColor); opacity: 0.75; margin: 0; max-width: 520px; }
.bbi-cta-section__actions { display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; }
.bbi-cta-section__trust { display: flex; align-items: flex-start; gap: 8px; font-size: 13px; color: var(--textColor); opacity: 0.75; line-height: 1.5; }
.bbi-cta-section__trust .dot { width: 6px; height: 6px; border-radius: 50%; background: #D4252A; flex-shrink: 0; margin-top: 4px; }
.bbi-cta-section__trust a { color: var(--linkColor); }

@media(max-width:980px){
  .lp-ds .bbi-footer__top{grid-template-columns:1fr;gap:var(--space-8);}
  .lp-ds .bbi-footer__cols{grid-template-columns:repeat(2,1fr);}
}
@media(max-width:640px){
  .lp-ds .bbi-footer__cols{grid-template-columns:1fr;}
}
@media(max-width:1023px){.lp-ds .lp-crosslinks__grid{grid-template-columns:1fr;}}
</style>

<div class="lp-ds scheme-default">

  {%- render 'bbi-nav', logo: section.settings.logo, active: 'services' -%}

  <!-- BREADCRUMBS (visible band mirrors the BreadcrumbList JSON-LD below) -->
  {%- render 'bbi-crumbs', c2_label: section.settings.crumb_label | default: 'Office Furniture in Mississauga' -%}

  <!-- HERO -->
  <section class="lp-hero" aria-label="Hero">
    <div class="lp-hero__inner">
      <div class="lp-hero__text">
        <p class="lp-hero__eyebrow bbi-mono">
          <span class="lp-hero__eyebrow-label">{{ section.settings.hero_eyebrow | default: 'Delivery & Installation · Mississauga' }}</span>
        </p>
        <span class="lp-hero__badge">
          <span class="lp-hero__badge-dot"></span>
          Ontario supplier since 1964 <svg class="bbi-icon bbi-icon--leaf" viewBox="0 0 13 13" fill="currentColor" aria-hidden="true"><path d="M6.5 0 L7.6 3.5 L11 2 L9 5 L13 6.5 L9.5 7 L11 10.5 L6.5 8.5 L2 10.5 L3.5 7 L0 6.5 L4 5 L2 2 L5.4 3.5 Z"/></svg>
        </span>
        <h1>{{ section.settings.hero_heading | default: 'Office furniture delivery and installation in Mississauga.' }}</h1>
