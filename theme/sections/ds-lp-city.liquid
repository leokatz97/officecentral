        </div>
      </div>
      <div class="lp-hero__media" aria-hidden="true">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', width: 900, alt: section.settings.hero_image.alt | default: section.settings.hero_heading | default: 'Office furniture delivery and installation in Mississauga — Brant Business Interiors' }}
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0859/0413/0361/files/design-services-product.png?v=1778074380" alt="{{ section.settings.hero_heading | default: 'Office furniture delivery and installation in Mississauga — Brant Business Interiors' | escape }}" loading="eager" width="900" height="400">
        {%- endif -%}
      </div>
    </div>
  </section>

  <!-- INTRO (answer-first lede) + E-E-A-T byline -->
  <section class="lp-intro" aria-label="Office furniture delivery and installation in {{ section.settings.city_name | default: 'Mississauga' | escape }}">
    <div class="lp-intro__inner">
      <p class="lp-intro__eyebrow bbi-mono">{{ section.settings.intro_eyebrow | default: 'The short answer' }}</p>
      <h2>{{ section.settings.intro_heading | default: 'Yes — Brant Business Interiors delivers and installs office furniture in Mississauga, with our own crew and one Ontario account team from quote to install.' }}</h2>
      <p class="lp-intro__byline">
        <span class="dot"></span>
        <span>{{ section.settings.eeat_note | default: 'Supplied by Brant Business Interiors — authorized contract-furniture dealer and OECM Supplier Partner, supplying and installing commercial office furniture across Ontario since 1964.' }}</span>
      </p>
      <div class="lp-intro__body">
        <div>
          <h3>{{ section.settings.intro_h3_1 | default: 'How we cover Mississauga' }}</h3>
          <p>{{ section.settings.intro_para1 | default: 'Brant Business Interiors is a family-owned Ontario commercial furniture dealer, headquartered at 701 The Queensway, Units 2-4 in Peterborough and serving Mississauga and the wider Greater Toronto Area. We are not a Mississauga storefront — we are the team that quotes your order, schedules a coordinated delivery window, and arrives with our own installation crew to place, assemble, and level every piece on site. One Ontario account team handles the quote, the delivery, the install, and any warranty service after.' }}</p>
        </div>
        <div>
          <h3>{{ section.settings.intro_h3_2 | default: 'Who we supply in Mississauga' }}</h3>
          <p>{{ section.settings.intro_para2 | default: 'Mississauga offices, private clinics, professional firms, schools, and municipal departments order from our full contract catalogue — seating, desks and workstations, boardroom and reception, storage, and acoustic. As an OECM Supplier Partner, eligible Ontario broader-public-sector buyers in Mississauga can purchase furniture and installation from us without an open tender. Single chair or a multi-floor fit-out, the same crew delivers and installs it.' }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW WE SERVE (feature blocks) -->
  {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
  {%- if feature_blocks.size > 0 -%}
  <section class="lp-diff" aria-label="How we serve {{ section.settings.city_name | default: 'Mississauga' | escape }}" style="background:var(--background);border-top:none;">
    <div class="lp-diff__inner">
      <div class="lp-diff__head">
        <p class="lp-diff__eyebrow bbi-mono">{{ section.settings.feature_eyebrow | default: 'How we serve Mississauga' }}</p>
        <h2>{{ section.settings.feature_heading | default: 'Delivery and installation, coordinated end to end.' }}</h2>
        {%- if section.settings.feature_sub != blank -%}<p class="lp-diff__sub">{{ section.settings.feature_sub }}</p>{%- endif -%}
      </div>
      <div class="lp-diff__grid{% if feature_blocks.size == 3 %} lp-diff__grid--3{% endif %}">
        {%- for block in feature_blocks -%}
          <article class="lp-diff-card" {{ block.shopify_attributes }}>
            <span class="lp-diff-card__num">0{{ forloop.index }}</span>
            <span class="lp-diff-card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
            </span>
            <h3 class="lp-diff-card__label">{{ block.settings.feat_title }}</h3>
            <p class="lp-diff-card__sentence">{{ block.settings.feat_body }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- RECENT LOCAL PROJECTS (local_proof blocks — REAL projects only; section omitted when none) -->
  {%- assign proof_blocks = section.blocks | where: 'type', 'local_proof' -%}
  {%- if proof_blocks.size > 0 -%}
  <section class="lp-diff" aria-label="Recent projects near {{ section.settings.city_name | default: 'Mississauga' | escape }}">
    <div class="lp-diff__inner">
      <div class="lp-diff__head">
        <p class="lp-diff__eyebrow bbi-mono">{{ section.settings.proof_eyebrow | default: 'Recent local projects' }}</p>
        <h2>{{ section.settings.proof_heading | default: 'Work we have delivered nearby.' }}</h2>
        {%- if section.settings.proof_sub != blank -%}<p class="lp-diff__sub">{{ section.settings.proof_sub }}</p>{%- endif -%}
      </div>
      <div class="lp-diff__grid{% if proof_blocks.size == 3 %} lp-diff__grid--3{% endif %}">
        {%- for block in proof_blocks -%}
          <article class="lp-diff-card" {{ block.shopify_attributes }}>
            {%- if block.settings.proof_meta != blank -%}<p class="lp-diff-card__meta">{{ block.settings.proof_meta }}</p>{%- endif -%}
            <h3 class="lp-diff-card__label">{{ block.settings.proof_title }}</h3>
            <p class="lp-diff-card__sentence">{{ block.settings.proof_body }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- BROWSE THE CATALOG (category_link blocks) -->
  {%- assign cat_blocks = section.blocks | where: 'type', 'category_link' -%}
  {%- if cat_blocks.size > 0 -%}
  <section class="lp-crosslinks" aria-label="Browse the catalogue">
    <div class="lp-crosslinks__inner">
      <div class="lp-crosslinks__head">
        <p class="lp-crosslinks__eyebrow bbi-mono">{{ section.settings.xlink_eyebrow | default: 'Browse the catalogue' }}</p>
        <h2>{{ section.settings.xlink_heading | default: 'Order anything from the catalogue — we deliver and install all of it.' }}</h2>
      </div>
      <div class="lp-crosslinks__grid">
        {%- for block in cat_blocks -%}
          {%- if block.settings.cat_url != blank -%}
          <a href="{{ block.settings.cat_url }}" class="lp-crosslinks__tile" {{ block.shopify_attributes }}>
            <span class="lp-crosslinks__tile-icon"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="5" y="3" width="18" height="22" rx="2"/><path d="M9 8 H19 M9 12 H19 M9 16 H15"/></svg></span>
            <span class="lp-crosslinks__tile-label"><span class="lp-crosslinks__tile-name">{{ block.settings.cat_label | default: 'Browse' }}</span>{% if block.settings.cat_meta != blank %}<span class="lp-crosslinks__tile-meta">{{ block.settings.cat_meta }}</span>{% endif %}</span>
            <span class="lp-crosslinks__tile-arrow"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 9 H15"/><path d="M10 4 L15 9 L10 14"/></svg></span>
          </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- ENTITY / OECM NOTE (single HQ — NAP unchanged) -->
  <section class="lp-entity-note" aria-label="Legal entity and OECM registration">
    <div class="lp-entity-note__inner">
      <span class="lp-entity-note__badge bbi-badge bbi-badge--oecm">
        <span class="dot"></span>
        OECM Supplier Partner
      </span>
      <p>{{ section.settings.entity_note | default: '<b>Brant Business Interiors</b> is registered under our parent legal entity, Brant Basics, as an authorized OECM Supplier Partner. Eligible Ontario broader-public-sector buyers — school boards, hospitals, and municipalities, including those in Mississauga — can purchase office furniture and installation from us without an open tender. Family-owned and supplying Ontario workplaces since 1964, from 701 The Queensway, Units 2-4, Peterborough, ON K9J 7J6.' }}</p>
    </div>
  </section>

  <!-- FAQ -->
  {%- comment -%}
    Byte-match (SCHEMA-CRIT-1): the visible accordion below and the faq_items list passed
    to bbi-faq-jsonld (after the footer) are built from the SAME faq_item blocks. Visible
    Q/A use `| escape`; the snippet serializes the same strings via `| json`. No divergent
    transforms. Block copy must contain neither "||" (the Q/A delimiter) nor "~~~" (the
    entry delimiter used to assemble the list — see below).
  {%- endcomment -%}
  {%- assign faq_blocks = section.blocks | where: 'type', 'faq_item' -%}
  {%- if faq_blocks.size > 0 -%}
  <section class="lp-faq" aria-label="Frequently asked questions">
    <div class="lp-faq__inner">
      <div class="lp-faq__head">
        <p class="lp-faq__eyebrow bbi-mono">Common questions</p>
        <h2>{{ section.settings.faq_heading | default: 'Office furniture in Mississauga — common buyer questions.' }}</h2>
      </div>
      <div class="lp-faq__list" id="city-faq-list">
        {%- for block in faq_blocks -%}
          <div class="lp-faq__item{% if forloop.first %} lp-faq__item--open{% endif %}" {{ block.shopify_attributes }}>
            <button class="lp-faq__trigger" aria-expanded="{{ forloop.first | json }}">
              <span class="lp-faq__trigger-num">0{{ forloop.index }}</span>
              <span>{{ block.settings.question | escape }}</span>
              <span class="lp-faq__chevron"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6 L8 11 L13 6"/></svg></span>
            </button>
            <div class="lp-faq__answer">
              <p>{{ block.settings.answer | escape }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- CTA CLOSER -->
  <section class="bbi-cta-section scheme-inverse" aria-label="Call to action">
    <div class="bbi-cta-section__inner">
      <div>
        <p class="bbi-cta-section__eyebrow">Request a quote</p>
        <h2 class="bbi-cta-section__heading">{{ section.settings.closer_heading | default: 'Furnishing an office in Mississauga? Talk to a real person.' }}</h2>
        <p class="bbi-cta-section__sub">{{ section.settings.closer_sub | default: 'Tell us the site, the headcount, and the timeline. We will quote the right furniture for your Mississauga workplace — delivered and installed by our own Ontario crew.' }}</p>
      </div>
      <div class="bbi-cta-section__actions">
        <a class="bbi-btn bbi-btn--primary bbi-btn--lg" href="{{ section.settings.closer_cta_url | default: '/pages/quote' }}">{{ section.settings.closer_cta_label | default: 'Request a Quote' }} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="bbi-btn bbi-btn--secondary bbi-btn--lg" href="tel:{{ section.settings.phone_href | default: '18008359565' }}" aria-label="Call Brant Business Interiors at {{ section.settings.phone | default: '1-800-835-9565' }}">Call {{ section.settings.phone | default: '1-800-835-9565' }}</a>
        <div class="bbi-cta-section__trust">
          <span class="dot"></span>
          <span><b>Brant Business Interiors</b> &middot; 701 The Queensway, Units 2-4, Peterborough, ON K9J 7J6 &middot; <a href="tel:18008359565">1-800-835-9565</a> &middot; supplying Ontario since 1964.</span>
        </div>
      </div>
    </div>
  </section>

  {%- render 'bbi-footer', logo: section.settings.logo -%}

  {%- comment -%} ── Entity JSON-LD (after footer). Organization/LocalBusiness is emitted by bbi-nav → bbi-org-schema and is NOT re-emitted here. NO city-specific LocalBusiness — areaServed only (NAP integrity). ── {%- endcomment -%}

  {%- render 'bbi-service-jsonld',
    service_name: section.settings.service_name | default: 'Office Furniture Delivery and Installation',
    service_description: section.settings.service_description | default: 'Commercial office furniture supply, delivery, and installation for Mississauga businesses and institutions — seating, desks and workstations, boardroom and reception, storage, and acoustic, from the brands Brant Business Interiors carries. Quoted, delivered, and installed by our own Ontario crew from our Peterborough headquarters. Authorized dealer with local warranty support; OECM Supplier Partner for eligible broader-public-sector buyers.',
    service_type: 'Office furniture delivery and installation',
    area_served: section.settings.service_area | default: 'Mississauga, Ontario, Canada',
    id_suffix: section.settings.service_id_suffix | default: 'service-city-mississauga'
  -%}

  {%- comment -%} BreadcrumbList — mirrors the visible crumb band: Home → <city>. Both URLs are unfiltered globals (shop.url / canonical_url), so they pass inline; no pre-assign needed (the snippet's assign-first rule is only for URLs built with a filter such as append). {%- endcomment -%}
  {%- render 'bbi-breadcrumb-jsonld',
      bc1_name: 'Home',
      bc1_url: shop.url,
      bc2_name: section.settings.crumb_label | default: 'Office Furniture in Mississauga',
      bc2_url: canonical_url
  -%}

  {%- comment -%} Build faq_items ("Question||Answer" per block) from the SAME blocks the accordion renders, then split into the array bbi-faq-jsonld expects. {%- endcomment -%}
  {%- liquid
    assign faq_build = ''
    for block in faq_blocks
      if block.settings.question != blank and block.settings.answer != blank
        assign faq_build = faq_build | append: block.settings.question | append: '||' | append: block.settings.answer | append: '~~~'
      endif
    endfor
    assign faq_items = faq_build | split: '~~~'
  -%}
  {%- render 'bbi-faq-jsonld', faq_items: faq_items -%}

</div><!-- /lp-ds -->

<script>
(function() {
  var list = document.getElementById('city-faq-list');
  if (!list) return;
  list.addEventListener('click', function(e) {
    var btn = e.target.closest('.lp-faq__trigger');
    if (!btn) return;
    var item = btn.closest('.lp-faq__item');
    var isOpen = item.classList.contains('lp-faq__item--open');
    list.querySelectorAll('.lp-faq__item--open').forEach(function(el) {
      el.classList.remove('lp-faq__item--open');
      el.querySelector('.lp-faq__trigger').setAttribute('aria-expanded', 'false');
    });
    if (!isOpen) {
      item.classList.add('lp-faq__item--open');
      btn.setAttribute('aria-expanded', 'true');
    }
  });
})();
</script>

