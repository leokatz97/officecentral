            <button class="lp-faq__trigger" aria-expanded="{{ forloop.first | json }}">
              <span class="lp-faq__trigger-num">0{{ forloop.index }}</span>
              <span>{{ block.settings.question | escape }}</span>
              <span class="lp-faq__chevron"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6 L8 11 L13 6"/></svg></span>
            </button>
            <div class="lp-faq__answer">
              <p>{{ block.settings.answer | escape }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- CTA CLOSER -->
  <section class="bbi-cta-section scheme-inverse" aria-label="Call to action">
    <div class="bbi-cta-section__inner">
      <div>
        <p class="bbi-cta-section__eyebrow">Request a quote</p>
        <h2 class="bbi-cta-section__heading">{{ section.settings.closer_heading | default: 'Spec your ergonomic chairs with a real person.' }}</h2>
