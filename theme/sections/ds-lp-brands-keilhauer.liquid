  {%- render 'bbi-brand-jsonld',
    brand_name: "Keilhauer",
    brand_description: "Keilhauer is a Canadian commercial seating manufacturer based in Toronto since 1981, producing contract-grade boardroom, lounge, and task seating for institutional and workplace environments.",
    same_as: "https://www.keilhauer.com",
    id_suffix: "brand-keilhauer"
  -%}

  {%- render 'bbi-service-jsonld',
    service_name: "Authorized Keilhauer Dealer",
    service_description: "Brant Business Interiors is an authorized Keilhauer dealer offering design-led contract boardroom, lounge, task seating, and tables for workplace, healthcare, and education environments across Ontario. Contact Brant Business Interiors for current Keilhauer model availability, custom specification, finish selection, delivery, and installation.",
    service_type: "Furniture Dealer",
    id_suffix: "service-keilhauer"
  -%}

  {%- comment -%}
    FAQPage (SCHEMA-CRIT-1): built from the SAME faq_item blocks the visible accordion renders.
    Assemble "Question||Answer" per block joined by "~~~", split into the array bbi-faq-jsonld expects.
    Snippet emits NOTHING if there are zero valid pairs (honesty rule). Net page schema after this build
    = 1 Brand (Keilhauer) + 1 Service (Authorized Keilhauer Dealer) + 1 FAQPage. No Organization
    re-emit (bbi-nav covers it). NO parentOrganization / NO manufacturer implication on the Service node.
  {%- endcomment -%}
  {%- liquid
    assign faq_blocks = section.blocks | where: 'type', 'faq_item'
    assign faq_build = ''
    for block in faq_blocks
      if block.settings.question != blank and block.settings.answer != blank
        assign faq_build = faq_build | append: block.settings.question | append: '||' | append: block.settings.answer | append: '~~~'
      endif
    endfor
    assign faq_items = faq_build | split: '~~~'
  -%}
  {%- render 'bbi-faq-jsonld', faq_items: faq_items -%}

</div><!-- /lp-keilhauer -->

{% schema %}
{
  "name": "Keilhauer Brand Page",
  "class": "ds-lp-brands-keilhauer",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "heading", "label": "H1 heading", "default": "Keilhauer seating for boardrooms, lounges, and workspaces." },
    { "type": "textarea", "id": "subheading", "label": "Hero standfirst", "default": "Brant Business Interiors is an authorized Keilhauer dealer serving Ontario institutions. We supply, quote, deliver, and install Keilhauer’s Toronto-made boardroom, lounge, and task seating. Quote in 1 business day." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (5:4)", "info": "Upload keilhauer-space.jpg from data/page-images/keilhauer/" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer (plain text — no \"||\" or \"~~~\")" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Keilhauer Brand Page",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "Is Brant Business Interiors a Keilhauer dealer?", "answer": "Yes. Brant Business Interiors is an authorized Keilhauer dealer serving Ontario. We supply, quote, deliver, and install the Keilhauer lines we carry — boardroom and conference chairs, lounge seating, task seating, and tables — for institutional and workplace clients, with delivery and installation by our own Ontario crew." } },
        { "type": "faq_item", "settings": { "question": "Where is Keilhauer furniture made?", "answer": "Keilhauer manufactures its products in Toronto, Ontario, and has been Canadian-owned and operated since 1981. Buying Canadian-made keeps lead times shorter than imported alternatives and means post-sale service and replacement parts do not require cross-border coordination." } },
        { "type": "faq_item", "settings": { "question": "What warranty do Keilhauer products carry?", "answer": "Keilhauer warrants its products against defects in materials and workmanship for 10 years under standard single-shift use — covering desk, conference and task chairs, lounge seating, and tables — with textiles warranted for 1 year. For heavy use above 40 hours per week the furniture warranty is 5 years. As your authorized dealer, Brant Business Interiors files warranty claims directly with Keilhauer on your behalf." } },
        { "type": "faq_item", "settings": { "question": "Can I specify custom fabric or my own material (COM)?", "answer": "Yes — Keilhauer offers a broad fabric library and supports COM (customer’s own material) on most upholstered products. Send us your fabric specification and we will confirm Keilhauer’s COM requirements — rub count, application, and yardage — and the lead time before your purchase order is issued." } },
        { "type": "faq_item", "settings": { "question": "Are Keilhauer products available to OECM buyers?", "answer": "Brant Business Interiors is registered under our parent legal entity, Brant Basics, as an authorized OECM Supplier Partner. Eligible Ontario broader-public-sector buyers — school boards, hospitals, and municipalities — can purchase office furniture and installation from us without an open tender. Family-owned and supplying Ontario workplaces since 1964, from 701 The Queensway, Units 2-4, Peterborough, ON K9J 7J6." } }
      ]
    }
  ]
}
{% endschema %}
