<a href="{{ routes.root_url }}" class="logo h6" aria-label="{{ shop.name }}">
  {% if section.settings.logo != blank %}
    {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
    {%- assign logo_w_display = section.settings.logo_width | times: 2 | round -%}
    {%- assign logo_height = logo_w_display | divided_by: section.settings.logo.aspect_ratio -%}
    {{
      section.settings.logo
      | image_url: width: 500
      | image_tag:
        class: 'header__heading-logo',
        widths: '100, 200, 300, 400, 500',
        height: logo_height,
        width: logo_w_display,
        alt: logo_alt
    }}
  {%- else -%}
    {{ shop.name }}
  {% endif %}
</a>