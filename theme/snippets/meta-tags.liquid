{%- liquid
    if template == 'index'
      assign og_title = 'Office Furniture for Canadian Businesses | Brant Business Interiors'
    else
      assign og_title = page_title | default: shop.name
    endif
    assign og_url = canonical_url | default: request.origin
    assign og_type = 'website'
    # SEO-AUDIT-1 FIX #3: BBI-voice fallback replaces stale shop.description on pages w/o per-page SEO desc
    assign bbi_default_desc = 'Commercial office furniture for Ontario businesses, schools, and institutions. ergoCentric, GFG, OTG, Heartwood, ObusForme. OECM Agreement 2025-470. Quote in 1 business day.'
    if template == 'index'
      assign og_description = 'Commercial office furniture for Ontario businesses, schools, and institutions. Global Furniture Group, OTG / Offices to Go, Heartwood Manufacturing. OECM Supplier Partner (Agreement 2025-470). Quote in 1 business day.'
    else
      assign og_description = page_description | default: bbi_default_desc
    endif

    if request.page_type == 'product'
      assign og_type = 'product'
    elsif request.page_type == 'article'
      assign og_type = 'article'
    elsif request.page_type == 'password'
      assign og_url = request.origin
    endif
  %}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ og_url }}">
  <meta property="og:title" content="{{ og_title | escape }}">
  <meta property="og:type" content="{{ og_type }}">
  <meta property="og:description" content="{{ og_description | escape }}">

  {%- comment -%} SEO-AUDIT-1 FIX #5: homepage og:image uses BBI og-preview.png (1024x1024 uploaded by FAVICON-1). Other templates fall back to page_image (product/article/page featured image). {%- endcomment -%}
  {%- if template == 'index' -%}
    {%- assign hp_og_url = 'og-preview.png' | asset_url -%}
    <meta property="og:image" content="{{ hp_og_url | replace: 'https:', 'http:' }}">
    <meta property="og:image:secure_url" content="{{ hp_og_url }}">
    <meta property="og:image:width" content="1024">
    <meta property="og:image:height" content="1024">
  {%- elsif page_image -%}
    <meta property="og:image" content="http:{{ page_image | image_url }}">
    <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
    <meta property="og:image:width" content="{{ page_image.width }}">
    <meta property="og:image:height" content="{{ page_image.height }}">
  {%- endif -%}
  
  {%- if request.page_type == 'product' -%}
    <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
    <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  {%- endif -%}
  {%- comment -%} HIGH-3 (2026-05-24): removed `{% unless settings.seo_microdata %}` wrapper + Shopify auto-Product JSON-LD ({{ product | structured_data }}). settings.seo_microdata is null on DEV → `unless null` evaluated true → Shopify auto-block fired alongside BBI's custom bbi-product-jsonld.liquid, producing duplicate Product emissions on every PDP. The custom block (richer: additionalProperty from specs metafields + brand + mpn) is now the sole Product schema source. {%- endcomment -%}
  {%- if settings.social_twitter_link != blank -%}
    <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ og_title | escape }}">
  <meta name="twitter:description" content="{{ og_description | escape }}">
  