# Generated script artifacts — regenerate with audit scripts, don't commit
data/backups/
data/logs/
data/exports/
data/specs.json
data/specs-run.log
data/theme-inventory.json
data/theme-coverage.md

# Transient drop zone for incoming design exports / zips before extraction
data/incoming/

# Root-level folders not part of this project
Design System Zips/
PE-review-2026-04-30/
Steve Claude Resume/

# Liquid backup files — use git history instead
theme/**/*.backup-*
theme/**/*-backup-*.liquid

# AI-generated images — runtime artefacts, regenerate with generate-*-images.py scripts
data/page-images/
data/generated-images/
data/generated-clean-images/
data/generated-img2img-images/
data/img2img/

# Raw screenshots dropped into oci-photos — only webp/jpg catalog files are committed
data/oci-photos/*.png
data/oci-photos/Screenshot*

# Generated logo option PNGs — regenerate with scripts/generate-logo-options.py
data/logos/options/*.png

# Review screenshots — reference only, not part of source
docs/reviews/*.png

# Claude Code internal project data
.claude/projects/

# Stray Avada theme snippets dumped at repo root by a misdirected `shopify theme pull`
# (canonical theme code lives under theme/snippets/)
/snippets/

# Timestamped build-state backups — keep current bbi-build-state.md, ignore .bak-* snapshots
BBI-Session-Kickoff/bbi-build-state.md.bak-*

# Forensic LIVE theme snapshots — meta/manifests committed, payload kept locally
# (payload contains theme/config/settings_data.json which is gitignored elsewhere too)
data/forensics/*/snapshot/

# --- Working-tree cleanup 2026-05-29 (WORKING-TREE-CLEANUP) ---

# Claude Code scheduled-task lock files (regenerated by the autonomous heartbeat)
.claude/*.lock

# Session scratch drop zone for in-progress working files (regenerable per task)
data/working/

