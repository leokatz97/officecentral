data/strategy/_path-z-*

# Root-level image working sets — regenerate with generate-*-images.py / design pipeline
/page-images/
/bbi-images-v2/

# Leo's personal design scratch — local working assets, never committed
/Leo/

# Manufacturer brochure PDFs + logo pulls — large binary reference material, kept local
/GLOBAL PHOTOS/
/Industry/

# Cloned external repo (github.com/nexu-io/open-design) dropped at root — never commit/submodule
/open design/

