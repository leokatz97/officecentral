  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What's included in the free design layout?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A to-scale CAD floor plan showing furniture placement for your space \u2014 based on your dimensions or a site visit. We use the same layout tools our commercial install teams work from."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a minimum project size?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No minimum. The service is free for any project, whether you're fitting out two workstations or a full floor."
        }
      },
      {
        "@type": "Question",
        "name": "How long does it take?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We typically deliver a first draft within 3\u20135 business days of receiving your project details."
        }
      },
      {
        "@type": "Question",
        "name": "Do I have to buy the furniture from you?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No obligation. The floor plan is yours either way. Most clients do order from us once they see the layout \u2014 but that's your decision."
        }
      },
      {
        "@type": "Question",
        "name": "Do you do space planning outside Ontario?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We work on spaces across Canada. Delivery and installation are Ontario-based \u2014 we'll be upfront about that during the design conversation."
        }
      }
    ]
  },
