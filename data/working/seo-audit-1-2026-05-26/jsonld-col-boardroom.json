  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Are boardroom tables and credenzas OECM-eligible under Agreement 2025-470?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Boardroom tables, matching credenzas, podiums, and AV-cabinet furniture in this collection are all covered under OECM Agreement 2025-470. Ontario school boards, hospitals, municipalities, colleges, and not-for-profits can purchase on an OECM purchase order. Call 1-800-835-9565 or email quotes@brantbusinessinteriors.com referencing the agreement."
        }
      },
      {
        "@type": "Question",
        "name": "Which brands do you carry for boardroom furniture?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Global Furniture Group is our primary line for boardroom tables, credenzas, and AV-cabinet builds \u2014 covering the full range from 8-seat to 20-seat tables. Heartwood is the typical pick when buyers want premium veneer surfaces, custom wood species, or matched executive-office suites. Brant Business Interiors quotes both alongside each other so you can compare price-point and finish before deciding."
        }
      },
      {
        "@type": "Question",
        "name": "Can you quote custom-veneer or premium-finish boardroom tables?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Heartwood and Global Furniture Group both support custom veneer species, custom edge details, and matched grain selection \u2014 common asks for executive boardrooms and corporate showcase rooms. Custom specifications take longer than stock builds. Call 1-800-835-9565 with the room dimensions, veneer preference, and any matched-furniture requirement and we'll send the quote with a manufacturer-confirmed ship date."
        }
      },
      {
        "@type": "Question",
        "name": "Can your design team help plan an AV-integrated boardroom?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. For boardroom and executive-meeting builds, our design team provides a free 2D layout that accounts for AV-cabinet placement, monitor and screen sightlines, podium positioning, and credenza coordination. We'll send you the plan before the PO so your IT or AV vendor can review electrical and cable routing alongside the furniture quote."
        }
      }
    ]
  },
